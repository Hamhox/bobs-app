{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/projects/:slug", "destination": "/project?project=:slug" },
    { "source": "/apps/interactive-gauges", "destination": "/apps/interactive-gauges/index.html" },
    { "source": "/apps/buildbooks", "destination": "/apps/buildbooks/index.html" },
    { "source": "/apps/trail-pack-builder", "destination": "/apps/trail-pack-builder/index.html" },
    { "source": "/apps/:slug", "destination": "/demo?project=:slug" }
  ]
}
